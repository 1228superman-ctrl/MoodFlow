<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleDisplayName</key><string>心绪</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>UILaunchScreen</key><dict/>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>UIBackgroundModes</key><array><string>audio</string><string>fetch</string></array>
  <key>BGTaskSchedulerPermittedIdentifiers</key><array><string>org.moodflow.validation.summary</string></array>
  <key>NSHealthShareUsageDescription</key><string>读取心率、HRV、睡眠及活动能量，用于身体状态及波动记录。</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>在你开启事件定位后，为当前波动记录一次位置。</string>
  <key>NSMicrophoneUsageDescription</key><string>在你确认后，录制最多三分钟的语音日记。</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>经你选择后，在设备上把已有语音录音转成文字。</string>
</dict></plist>
